/*
 * vbmcp.rc - Windows 资源文件
 * 为插件DLL提供版本信息和FILEVERSION。
 */
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "vbmcp project"
            VALUE "FileDescription",  "VB Decompiler MCP Server Plugin"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "vbmcp"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "vbmcp.dll"
            VALUE "ProductName",      "VB Decompiler MCP Server"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
