<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>vbdmcp</RootNamespace>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v142</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v142</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)'=='Debug'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)'=='Release'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OutDir>$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\obj\</IntDir>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
    <TargetName>vbdmcp</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;_DEBUG;_WINDOWS;_USRDLL;VBDMCP_EXPORTS;_CRT_SECURE_NO_WARNINGS;NOMINMAX;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <Optimization>Disabled</Optimization>
      <MinimalRebuild>false</MinimalRebuild>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- /EHa：C++ 异常（try/catch 包住 MCP 入口）与 vbdec_sdk 的 SEH __try 保护共存 -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalIncludeDirectories>$(ProjectDir)third_party\yyjson\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ModuleDefinitionFile>src\vbdmcp.def</ModuleDefinitionFile>
      <AdditionalDependencies>ws2_32.lib;user32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;VBDMCP_EXPORTS;_CRT_SECURE_NO_WARNINGS;NOMINMAX;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- /EHa：C++ 异常（try/catch 包住 MCP 入口）与 vbdec_sdk 的 SEH __try 保护共存 -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalIncludeDirectories>$(ProjectDir)third_party\yyjson\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ModuleDefinitionFile>src\vbdmcp.def</ModuleDefinitionFile>
      <AdditionalDependencies>ws2_32.lib;user32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="res\resource.h" />
    <ClInclude Include="src\i18n.h" />
    <ClInclude Include="src\khash.h" />
    <ClInclude Include="src\marks.h" />
    <ClInclude Include="src\mcp_tools.h" />
    <ClInclude Include="src\vbdmcp.h" />
    <ClInclude Include="src\vbdmcp_ids.h" />
    <ClInclude Include="src\vbdmcp_mem.hpp" />
    <ClInclude Include="third_party\yyjson\src\yyjson.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\config.cpp" />
    <ClCompile Include="src\i18n.cpp" />
    <ClCompile Include="src\marks.cpp" />
    <ClCompile Include="src\mcp_http.cpp" />
    <ClCompile Include="src\mcp_rpc.cpp" />
    <ClCompile Include="src\mcp_tools.cpp" />
    <ClCompile Include="src\options_dialog.cpp" />
    <ClCompile Include="src\plugin_main.cpp" />
    <ClCompile Include="src\util.cpp" />
    <ClCompile Include="src\vbdec_sdk.cpp" />
    <!-- 第三方库保持 C 编译（yyjson 官方源码为 C99） -->
    <ClCompile Include="third_party\yyjson\src\yyjson.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <None Include="src\vbdmcp.def" />
    <None Include="lang_res\zh.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- res/vbdmcp.rc is owned by the Visual Studio resource editor: every save
         rewrites the whole file and drops "#include <windows.h>", which rc.exe
         needs for the DIALOGEX keywords (DS_SETFONT / WS_* / ES_* / BS_* ...).
         So it is NOT compiled directly: the VbmcpPrepRc target below builds a
         wrapper that pulls windows.h in first and then includes it verbatim,
         which lets the UI be edited in the resource editor without breaking
         the build. -->
    <ResourceCompile Include="res\vbdmcp.rc" />
  </ItemGroup>
  <PropertyGroup>
    <BeforeResourceCompileTargets>$(BeforeResourceCompileTargets);VbmcpPrepRc</BeforeResourceCompileTargets>
  </PropertyGroup>
  <Target Name="VbmcpPrepRc">
    <MakeDir Directories="$(IntDir)rc" />
    <!-- rc.exe resolves a RCDATA file name relative to the file being compiled,
         which here is $(IntDir)rc\vbdmcp_build.rc. The language pack therefore
         has to sit one level above it for the "..\lang_res\zh.json" path that
         vbdmcp.rc uses to keep resolving. -->
    <Copy SourceFiles="$(ProjectDir)lang_res\zh.json"
          DestinationFolder="$(IntDir)lang_res"
          SkipUnchangedFiles="true" />
    <PropertyGroup>
      <VbmcpRcWrapper>/* 由 VbmcpPrepRc 生成，勿手改（每次构建都会重写）。
   1) 先引入 DIALOGEX 模板关键字（DS_SETFONT / WS_* / ES_* ... 都在 windows.h 里）。
      注意：VS 资源编辑器保存时会删掉 .rc 里的 #include &lt;windows.h&gt;，所以只能在这里补。
      用 windows.h 而不是更轻的 winresrc.h：后者带来的宏集合不同，冲突反而更多。
   2) 下面三个 #undef 用来消掉 RC4005 重定义警告：windows.h 已定义它们，而编辑器生成的
      resource.h 会用相同值再定义一次（rc.exe 对"值相同"的重定义也报警）。
      模板里不会用到这三个宏，#undef 之后 resource.h 的定义成为首次定义，警告消失。 */
#include &lt;windows.h&gt;
#undef HTERROR
#undef PWR_FAIL
#undef HTTRANSPARENT
#include &quot;$(ProjectDir)res\vbdmcp.rc&quot;</VbmcpRcWrapper>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntDir)rc\vbdmcp_build.rc"
                      Lines="$(VbmcpRcWrapper)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <!-- Swap the editor-owned script for the wrapper. ResourceCompile has no
           ExcludedFromBuild support, so the item list is edited here instead. -->
      <ResourceCompile Remove="res\vbdmcp.rc" />
      <ResourceCompile Include="$(IntDir)rc\vbdmcp_build.rc" />
    </ItemGroup>
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>